{# Home Server — Caddy configuration
   Generated by Ansible from roles/platform/caddy/templates/volumes/caddy-etc/Caddyfile.j2.

   Design: one site block per name (apex + each reverse-proxied
   subdomain), each with its own cert. Avoids the apex+wildcard
   parallel-ACME-order race documented in issue #170: when both
   `{{ caddy_domain }}` and `*.{{ caddy_domain }}` lived in one site
   block, Caddy created two parallel orders that both wrote DNS-01
   challenges to the SAME TXT name (`_acme-challenge.{{ caddy_domain }}`)
   and clobbered each other under the deSEC plugin's RRset-replace
   semantics. Per-name site blocks → per-name `_acme-challenge.<sub>`
   TXTs → no shared namespace, no race.

   Trade-off: N+1 ACME orders on first deploy (apex + every
   reverse_proxy_services entry). Well under LE's 50/week per-domain
   rate limit for typical home-server deployments. Renewals happen at
   different times so no surge. #}

# Global ACME — DNS-01 challenge against {{ caddy_acme_provider }}.
# All three supported provider plugins (desec / cloudflare / hetzner)
# are bundled in the custom Caddy image — switching providers is just
# an inventory change.
{
	acme_dns {{ caddy_acme_provider }} {
		token {{ caddy_acme_token }}
	}
{% if caddy_acme_ca | default('') | length > 0 %}
	# Override ACME directory (default = LE production). Used on test
	# boxes to point at LE staging and dodge production rate limits.
	acme_ca {{ caddy_acme_ca }}
{% endif %}
}

# Apex — dashboard landing page.
{{ caddy_domain }} {
	tls {
		propagation_delay 2m
	}
	root * /srv/dashboard
	header Cache-Control "no-store, max-age=0"
	file_server
}

{% for svc in caddy_reverse_proxy_services %}
# {{ svc.subdomain }} → {{ svc.proto | default('http') }}://localhost:{{ svc.port }}
{{ svc.subdomain }}.{{ caddy_domain }} {
	tls {
		propagation_delay 2m
	}
	reverse_proxy {{ svc.proto | default('http') }}://host.containers.internal:{{ svc.port }} {
{% if (svc.proto | default('http')) == 'https' %}
		transport http {
			tls_insecure_skip_verify
		}
{% endif %}
	}
}

{% endfor %}
