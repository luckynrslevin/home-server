[Unit]
Description=Ente Photos decrypted export to NAS
# Started by the .timer; not at boot.
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ entephoto_export_nas_path }}

[Container]
ContainerName=%N
Image={{ entephoto_export_image }}
Network=host

# State volume holds the CLI's auth tokens + per-account sync state
# so subsequent runs are incremental.
Volume=entephoto-export-state.volume:/data

# NAS export directory — destination for decrypted photos +
# Google-Takeout-style metadata sidecars.
Volume={{ entephoto_export_nas_path }}:/export:Z

Environment=ENTE_CLI_CONFIG_DIR=/data

# Run the export once and exit. The .timer reschedules.
Exec=ente export --dir /export

[Service]
# One-shot: timer fires it, container runs to completion, exits 0.
Type=oneshot
Restart=no
TimeoutStartSec=0
