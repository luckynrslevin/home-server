# Home Server — Caddy configuration
# Generated by Ansible from roles/caddy/templates/volumes/caddy-etc/Caddyfile.j2

# Global ACME — DNS-01 challenge against {{ caddy_acme_provider }}.
# One wildcard cert covers the apex + every reverse-proxied
# subdomain ({{ caddy_domain }} and *.{{ caddy_domain }}). All three
# supported provider plugins (desec / cloudflare / hetzner) are
# bundled in the custom Caddy image — switching providers is just
# an inventory change.
{
	acme_dns {{ caddy_acme_provider }} {
		token {{ caddy_acme_token }}
	}
}

# Single site block — one wildcard cert, host-matchers route by Host.
*.{{ caddy_domain }}, {{ caddy_domain }} {
	tls {
		propagation_delay 2m
	}

{% for svc in caddy_reverse_proxy_services %}
	@{{ svc.subdomain }} host {{ svc.subdomain }}.{{ caddy_domain }}
	handle @{{ svc.subdomain }} {
		reverse_proxy {{ svc.proto | default('http') }}://host.containers.internal:{{ svc.port }} {
{% if (svc.proto | default('http')) == 'https' %}
			transport http {
				tls_insecure_skip_verify
			}
{% endif %}
		}
	}

{% endfor %}
	# Anything not matched above → dashboard at the apex.
	handle {
		root * /srv/dashboard
		header Cache-Control "no-store, max-age=0"
		file_server
	}
}
