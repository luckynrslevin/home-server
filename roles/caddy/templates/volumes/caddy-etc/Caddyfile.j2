{# Home Server — Caddy configuration
   Generated by Ansible from roles/caddy/templates/volumes/caddy-etc/Caddyfile.j2

   ACME provider selection — see roles/caddy/defaults/main.yml.
   When caddy_acme_provider is "internal" we keep `tls internal`
   per-site and the /trust HTTP landing-page exemption stays
   enabled. When it's a real DNS-01 provider (desec / cloudflare /
   hetzner) we emit a global `acme_dns` block, drop the `tls
   internal` lines, and skip the trust-bootstrap HTTP exemption
   (no need — devices already trust the public LE root). #}
# Home Server — Caddy configuration
# Generated by Ansible from roles/caddy/templates/volumes/caddy-etc/Caddyfile.j2

{% if caddy_acme_provider != 'internal' %}
# ------------------------------------------------------------------
# Global ACME — DNS-01 challenge against {{ caddy_acme_provider }}.
# Caddy auto-issues real Let's Encrypt certs (wildcard where the
# site name uses one). No `tls internal` needed per site.
# ------------------------------------------------------------------
{
	acme_dns {{ caddy_acme_provider }} {{ caddy_acme_token }}
}

{% endif %}
{% if caddy_domain %}
# ==================================================================
# Reverse proxy mode — subdomain-based routing with auto HTTPS
# ==================================================================

{% if caddy_acme_provider == 'internal' %}
# HTTP — bootstrap path for trusting the internal CA.
# Caddy by default 301-redirects port 80 → 443, but a fresh device
# can't reach 443 cleanly until it trusts our CA. Exempt three
# specific paths from the redirect so the user can fetch the cert,
# the Apple profile, and the install instructions over plain HTTP.
# The published artifacts are the public part of the CA + install
# docs; nothing secret.
http://{{ caddy_domain }} {
	@bootstrap path /trust /trust.html /caddy-root.crt /caddy-trust.mobileconfig
	handle @bootstrap {
		root * /srv/dashboard
		try_files {path} {path}.html
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

{% endif %}
# Dashboard (root domain)
{{ caddy_domain }} {
{% if caddy_acme_provider == 'internal' %}
	tls internal
{% endif %}
	root * /srv/dashboard
	header Cache-Control "no-store, max-age=0"
	file_server
}

# Service reverse proxies
{% for svc in caddy_reverse_proxy_services %}
{% if svc.tls | default(true) %}
{{ svc.subdomain }}.{{ caddy_domain }} {
{% if caddy_acme_provider == 'internal' %}
	tls internal
{% endif %}
{% else %}
http://{{ svc.subdomain }}.{{ caddy_domain }} {
{% endif %}
	reverse_proxy {{ svc.proto | default('http') }}://host.containers.internal:{{ svc.port }} {
{% if (svc.proto | default('http')) == 'https' %}
		transport http {
			tls_insecure_skip_verify
		}
{% endif %}
	}
}

{% endfor %}
{% else %}
# ==================================================================
# Simple mode — dashboard only on port 80 (no reverse proxy)
# ==================================================================

:80 {
	root * /srv/dashboard
	header Cache-Control "no-store, max-age=0"
	file_server
}
{% endif %}
