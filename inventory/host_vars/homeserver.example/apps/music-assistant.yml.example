# EXAMPLE — copy to <hostname>/apps/music-assistant.yml and edit.
# (Tool-managed in real installs — `homeserver.sh add music-assistant`
#  generates a stable MAC and writes this file.)

##################################################################################################
### Music Assistant — multi-room audio + streaming aggregator.
###
### >>> YOU MUST SET (auto-generated by `homeserver.sh add`):
# Stable, locally-administered MAC so SlimProto identifies the player
# across redeploys. Generate one: printf '02:%02x:%02x:%02x:%02x:%02x\n' \
# $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256)) $((RANDOM%256))
music_assistant_squeezelite_mac: "02:53:25:03:c0:e2"

###
### Defaults — usually no need to change:
# Audio output preset matching your DAC (see roles/apps/music-assistant/README.md).
# music_assistant_squeezelite_preset: "topping-D10s"

# Internal hostnames the MA pod needs to resolve go in 20-extras.yml
# under `music_assistant_internal_hosts:`.
