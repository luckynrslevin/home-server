# EXAMPLE — copy to <hostname>/apps/jellyfin.yml and edit.
# (Tool-managed in real installs — `homeserver.sh add jellyfin`
#  generates the admin password and writes this file.)

##################################################################################################
### Jellyfin — media server (movies / TV / music).
###
### >>> YOU MUST SET (auto-generated by `homeserver.sh add`):
jellyfin_admin_password: !vault |
  <ansible-vault-encrypted admin password — openssl rand -base64 24>

# NFS mounts + HW transcoding go in 20-extras.yml (operator-managed).
# Admin username defaults to `jellyfinadmin` — override via
# `jellyfin_admin_user:` here if you renamed the account in the UI.
