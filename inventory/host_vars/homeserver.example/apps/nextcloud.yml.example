# EXAMPLE — copy to <hostname>/apps/nextcloud.yml and edit.
# (Tool-managed in real installs — `homeserver.sh add nextcloud`
#  generates the secrets and writes this file.)

##################################################################################################
### Nextcloud — files + contacts + OIDC identity provider for other apps.
###
### >>> YOU MUST SET (auto-generated by `homeserver.sh add`):
nextcloud_admin_password: !vault |
  <ansible-vault-encrypted admin password — openssl rand -base64 24>
nextcloud_db_password: !vault |
  <ansible-vault-encrypted postgres password — openssl rand -base64 24>
