# EXAMPLE — copy to <hostname>/apps/paperless-ngx.yml and edit.
# (Tool-managed in real installs — `homeserver.sh add paperless-ngx`
#  generates the secrets and writes this file.)

##################################################################################################
### Paperless-NGX — document OCR + tagging + search.
###
### >>> YOU MUST SET (auto-generated by `homeserver.sh add`):
paperless_url: "https://paperless.example.dedyn.io"   # rendered from caddy_domain
paperless_secret_key: !vault |
  <ansible-vault-encrypted — openssl rand -hex 32>
paperless_db_password: !vault |
  <ansible-vault-encrypted postgres password — openssl rand -base64 24>
paperless_admin_password: !vault |
  <ansible-vault-encrypted admin password — openssl rand -base64 24>

# Optional SFTP sidecar config lives in 20-extras.yml (operator-managed).
