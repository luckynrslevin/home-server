# Automation perspective: who does what, in which order, to bring a
# fresh box up to a fully-deployed homeserver.
#
# Render: d2 docs/diagrams/automation.d2 docs/diagrams/automation.svg

# Top-level 2-column grid: repos | target. homeserver.sh runs on the
# target (curl one-liner bootstraps it) and drives the whole install
# locally, so there's no separate Ansible-host column anymore.
vars: {
  d2-config: {
    theme-id: 3 # terrastruct
    sketch: true
    layout-engine: elk
  }
  colors: {
    c2: "#C7F1FF" # light turkuaz
    c3: "#B5AFF6" # dark purple
    c4: "#DEE1EB" # gray
    c5: "#88DCF7" # turkuaz
    c6: "#E4DBFE" # purple
  }
}

grid-columns: 3
horizontal-gap: 30

repos: "" {
  style.opacity: 0
  style.fill: "#ffffff"
  grid-rows: 2

  pubrepo: "github.com/luckynrslevin/home-server.git\n\npublic repo contains\nansible playbooks + roles to\ninstall and configure\n the applications" {
    shape: cylinder
  }

  privrepo: "<git-env-of-your-choice>/home-server-private.git\n\nyour private repo contains:\npersonal configuration\n+ encrypted secrets / passwords" {
    shape: cylinder
  }
}

spacer: "" {
  style.opacity: 0
  style.fill: "#ffffff"
  width: 220
}

target: "homeserver" {
  label.near: top-center
  grid-columns: 1
  style.fill: ${colors.c4}

  fresh: "fresh OS install\n(AlmaLinux 9.x)"
  homeserver_sh: "homeserver.sh\n\n(curl-installed one-liner;\nclones both repos,\ninstalls ansible + podman,\nruns site.yml locally,\nschedules backup.yml)"
  deployed: "fully deployed\n(all services running)"
}

repos.pubrepo -> target.homeserver_sh {
  style: {
    stroke-dash: 3
    animated: true
  }
}
repos.privrepo -> target.homeserver_sh {
  style: {
    stroke-dash: 3
    animated: true
  }
}

target.fresh -> target.homeserver_sh {
  style: {
    stroke-dash: 3
    animated: true
  }
}

target.homeserver_sh -> target.deployed {
  style: {
    stroke-dash: 3
    animated: true
  }
}
