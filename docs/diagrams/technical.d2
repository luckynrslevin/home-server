# Technical-architecture perspective: rootful + rootless containers
# wired into the host's systemd via podman quadlets, with an external
# NAS receiving backups in three flavours (tar / pgdump / rsync).
#
# Render: d2 docs/diagrams/technical.d2 docs/diagrams/technical.svg

# Top-level 2-column grid: homeserver (left, contains OS + containers)
# | NAS (right).

vars: {
  d2-config: {
    theme-id: 3 # terrastruct
    sketch: true
    layout-engine: elk
  }
  colors: {
    c2: "#C7F1FF" # light turkuaz
    c3: "#B5AFF6" # dark purple
    c4: "#DEE1EB" # gray
    c5: "#88DCF7" # turkuaz
    c6: "#E4DBFE" # purple
  }
}
grid-columns: 2
horizontal-gap: 80

homeserver: "homeserver" {
  label.near: top-center
  style.fill: ${colors.c4}

  # Inside homeserver: 2 columns — Base OS on the left, containers
  # (rootful + rootless stacked) on the right.
  grid-columns: 2

  os: "OS" {
    label.near: top-center
    packages: |md
      # AlmaLinux 9.x
      - podman ≥ 5 (quadlet support)
      - nfs-utils (NAS mounts)
      - firewalld
      - systemd
      - dnf-automatic (security updates)
      - SELinux
    |
  }

  # Invisible wrapper so rootful + rootless stack vertically as one
  # column to the right of Base OS.
  workloads: "" {
    style.opacity: 0
    grid-rows: 2

    rootful: "Rootful containers\n(Only in case rootless is not possible)" {
      style.multiple: true
      label.near: top-center
      direction: right
      container: "container"
      volume: "volume" { shape: cylinder }
      container -- volume
    }

    rootless: "Rootless containers\n(Dedicated linux user for each app)" {
      style.multiple: true
      label.near: top-center
      direction: right
      container: "container"
      volume: "volume" { shape: cylinder }
      container -- volume
    }
  }
}

nas: "NAS" {
  label.near: top-center
  style.fill: ${colors.c4}
  grid-columns: 1
  tar: "tar\nconfig / state volumes" { shape: cylinder }
  pgdump: "pgdump\nPostgres logical dumps" { shape: cylinder }
  rsync: "rsync\nbulk / media data" { shape: cylinder }
}

homeserver.workloads.rootful -> nas: "backup" {
  style.stroke-dash: 3
  style.animated: true
  }
homeserver.workloads.rootless -> nas: "backup" {
  style.stroke-dash: 3
  style.animated: true
  }
