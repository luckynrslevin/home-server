vault.pw
*.retry
.vscode/
.claude/settings.local.json
.ansible/
# ansible.cfg is bootstrapped from ansible.cfg.example (dev workstations)
# or written by homeserver.sh install (deployed hosts). It MUST stay
# untracked so a `git pull` / `git reset` doesn't clobber the local
# vault_password_file path each tool wrote.
ansible.cfg

# Private inventory and secrets (use *.example files as templates)
inventory/hosts.yml
inventory/host_vars/homeserver.yml
# Local symlinks into the private repo
inventory/host_vars/homeserver
inventory/host_vars/homeserver-test
inventory/host_vars/homeserver2

# Syncthing personal config (device IDs, private key)
roles/syncthing/files/volumes/syncthing-config/config/key.pem
roles/syncthing/files/volumes/syncthing-config/config/cert.pem
roles/syncthing/templates/volumes/syncthing-config/config/config.xml.j2
.claude/scheduled_tasks.lock

# Python bytecode cache from local helper scripts
__pycache__/
*.pyc
